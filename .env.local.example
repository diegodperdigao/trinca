# ===== Supabase =====
# 1. Crie um projeto em https://supabase.com (plano free)
# 2. Em Settings → API, copie o Project URL e o anon public key abaixo
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# ===== App =====
# URL base pra os links de reset de senha redirecionarem de volta corretamente.
# Em dev deixe http://localhost:3000. Em prod, a URL do domínio.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Observação: a whitelist de e-mails autorizados fica na tabela
# `public.allowed_users` no Supabase, não em env var. Veja SETUP.md.
