# ===== Supabase =====
# 1. Crie um projeto em https://supabase.com (plano free)
# 2. Em Settings → API, copie o Project URL e o anon public key abaixo
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# ===== Auth whitelist =====
# E-mails autorizados a entrar, separados por vírgula.
# Qualquer pessoa fora da lista que tentar usar magic link é bloqueada.
ALLOWED_EMAILS=voce@exemplo.com,socio@trincadoigaming.com.br

# ===== App =====
# URL de produção pra o magic link redirecionar certo.
# Em dev deixe http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
